# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://compliai:compliai_dev@localhost:5432/compliai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AWS / S3-compatible storage ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=compliai
# Leave empty for real AWS; set to MinIO URL for local dev
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
