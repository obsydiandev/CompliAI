# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://compliai:compliai_dev@localhost:5432/compliai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AWS / S3-compatible storage ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=compliai
# Leave empty for real AWS; set to MinIO URL for local dev
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ─── Celery / Task Queue ──────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# How often periodic compliance checks run (seconds), default: 3600 (1 hour)
COMPLIANCE_CHECK_INTERVAL_SECONDS=3600

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Leave blank to disable email alerts (in_app alerts always active)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@compliai.io

# ─── SSO / OIDC ───────────────────────────────────────────────────────────────
# Google OIDC
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Microsoft / Azure AD OIDC
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT_ID=common
# Generic OIDC (Okta etc.) — set DISCOVERY_URL to your IdP's well-known URL
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_DISCOVERY_URL=

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
